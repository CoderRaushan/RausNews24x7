<% layout("/layouts/boilerplate") -%>
    <style>
        body {
            padding: 0;
            margin: 0;
            background-color: #a5a2dc;
            /* color: #000; */
        }

        .starability-result {
            position: relative;
            width: 150px;
            height: 30px;
            background-image: url("data:image/png;base64,");
            font-size: 0.1em;
            color: transparent;
        }

        .starability-result:after {
            content: ' ';
            position: absolute;
            left: 0;
            height: 30px;
            background-image: url("data:image/png;base64,");
            background-position: 0 -30px;
            background-size: 30px auto;
        }

        .starability-result[data-rating="5"]::after {
            width: 150px;
        }

        .starability-result[data-rating="4"]::after {
            width: 120px;
        }

        .starability-result[data-rating="3"]::after {
            width: 90px;
        }

        .starability-result[data-rating="2"]::after {
            width: 60px;
        }

        .starability-result[data-rating="1"]::after {
            width: 30px;
        }

        /* For high resolution devices */
        @media screen and (-webkit-min-device-pixel-ratio: 2),
        screen and (min-resolution: 192dpi) {
            .starability-result {
                background-image: url("data:image/png;base64,");
                background-size: 30px auto;
            }

            .starability-result:after {
                background-image: url("data:image/png;base64,");
                background-position: 0 -30px;
            }
        }
    </style>

    <body>
        <div>
            <div class="col col-lg-8 offset-lg-2 mt-5">
                <h3>&nbsp;<%= news.title %>
                </h3>
                <div class="card">
                    <div class="card">
                        <% const fileExtension=news.image.url.split('.').pop().toLowerCase(); const
                            imageFormats=["png", "jpg" , "jpeg" , "webp" , "avif" ]; const videoFormats=["mp4"]; const
                            pdfFormat=["pdf"]; const docFormats=["docx", "doc" , "xlsx" , "xls" , "ppt" , "pptx" ]; %>
                            <!-- Conditional Rendering -->
                            <% if (imageFormats.includes(fileExtension)) { %>
                                <!-- Display Image -->
                                <img class="card-img-top custom_img" src="<%= news.image.url %>"
                                    alt="<%= news.image.filename %>">
                                <% } else if (videoFormats.includes(fileExtension)) { %>
                                    <!-- Display Video -->
                                    <video controls class="card-img-top custom_img" style="max-width: 100%;">
                                        <source src="<%= news.image.url %>" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                    <% } else if (pdfFormat.includes(fileExtension)) { %>
                                        <!-- Display PDF -->
                                        <iframe src="<%= news.image.url %>" width="100%" height="1200px"></iframe>
                                        <% } else if (docFormats.includes(fileExtension)) { %>
                                            <!-- Display Download Link for Documents -->
                                            <a href="<%= news.image.url %>" target="_blank" class="btn btn-primary">
                                                View Document (<%= fileExtension.toUpperCase() %>)
                                            </a>
                                            <% } else { %>
                                                <p>Unsupported file format!</p>
                                                <% } %>
                                                    <div class="card-body">
                                                        <p class="card-text"> Owner : <i>
                                                                <%=news.owner.username %>
                                                            </i></p>
                                                        <p class="card-text"
                                                            style="white-space: pre-wrap; background-color: #f4f4f4; padding: 10px;">
                                                            <%=news.description %>
                                                        </p>
                                                        <p class="card-text">
                                                            <%=news.location %>
                                                        </p>
                                                        <p class="card-text">
                                                            <%=news.country %>
                                                        </p>
                                                    </div>
                    </div>
                    <% if(currUser && currUser._id.equals(news.owner._id)) {%>
                        <div class="d-flex align-items-stretch">
                            <form method="put" action="/news/<%=news._id%>/edit">
                                <button class="btn btn-warning">Update</button>
                            </form> &nbsp; &nbsp;
                            <form method="post" action="/news/<%=news._id %>?_method=delete">
                                <button class="btn btn-danger">delete</button>
                            </form>
                        </div>
                        <% } %>
                            <div class="col-8 offset-2">
                                <h4>Leave a review</h4>
                                <% if(currUser){ %>
                                    <form action="/news/<%= news._id %>/reviews" method="post" novalidate
                                        class="needs-validation">
                                        <div>
                                            <label for="rating" class="form-label">Rating:</label>
                                            <label for="rating" class="form-label">Rating:</label>
                                            <fieldset class="starability-slot">
                                                <select id="rating" class="form-control bg-warning"  name="newsreview[rating]"
                                                    aria-label="Rating">
                                                    <option value="0" selected>0 star</option>
                                                    <option value="1">1 star</option>
                                                    <option value="2">2 stars</option>
                                                    <option value="3">3 stars</option>
                                                    <option value="4">4 stars</option>
                                                    <option value="5">5 stars</option>
                                                </select>
                                            </fieldset>

                                            <div class="invalid-feedback">
                                                Please provide a rating.
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label" for="comment">Comment:</label> <br> <br>
                                            <textarea name="newsreview[comment]" id="comment" rows="5" cols="40"
                                                class="form-control" required></textarea>
                                            <div class="invalid-feedback">
                                                Please add a comment.
                                            </div>
                                        </div>
                                        <br>
                                        <button class="btn btn-warning" type="submit">Post</button>
                                    </form>
                                    <% } %>
                                        <hr>
                                        <p><b>All reviews</b></p>
                                        <div class="row">
                                            <% for(review of news.reviews) {%>
                                                <div class="card col-lg-5 ms-lg-4 mb-3"
                                                    style="border: 2px solid black; box-shadow: 2px 3px 5px black;">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@<%= review.author.username %>
                                                        </h5>
                                                        <p class="starability-result card-text"
                                                            data-rating="<%=review.rating %>">
                                                            Rated: <%=review.rating %> stars
                                                        </p>
                                                        <p class="card-text">
                                                            <%=review.comment %>
                                                        </p>
                                                        <form
                                                            action="/news/<%= news._id %>/reviews/<%= review._id %>?_method=delete"
                                                            method="post">
                                                            <% if(currUser && currUser._id.equals(news.owner._id)) {%>
                                                                <button class="btn btn-sm btn-danger">Delete</button>
                                                                <% } %>
                                                        </form>
                                                    </div>
                                                </div>
                                                <%}%>
                                        </div>
                            </div>
                </div>
            </div>
        </div>
        </div>
        <br>
    </body>