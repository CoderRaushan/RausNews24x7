<% layout("/layouts/boilerplate") -%>
    <div class="card_parent_container row-col-lg-3  row-col-md-3 row-col-sn-1 mt-3">
        <% for(let news of allnews) { %>
            <a class="card_anchor_tag" href="<%= news._id %>">
                <div class="card" style="width: 20rem;">
                    <% 
                            // Extract file extension
                            const fileExtension = news.image.url.split('.').pop().toLowerCase(); 
                            // Define supported formats
                            const imageFormats = ["png", "jpg", "jpeg", "webp", "avif"];
                            const videoFormats = ["mp4"];
                            const pdfFormat = ["pdf"];
                            const docFormats = ["docx", "doc", "xlsx", "xls", "ppt", "pptx"];
                        %>
                        <!-- Conditional Rendering -->
                        <% if (imageFormats.includes(fileExtension)) { %>
                            <!-- Display Image -->
                            <img class="card-img-top custom_img" src="<%= news.image.url %>" alt="<%= news.image.filename %>">
                        <% } else if (videoFormats.includes(fileExtension)) { %>
                            <!-- Display Video -->
                            <video controls class="card-img-top custom_img" style="max-width: 100%;">
                                <source src="<%= news.image.url %>" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        <% } else if (pdfFormat.includes(fileExtension)) { %>
                            <!-- Display PDF -->
                            <iframe src="<%= news.image.url %>" width="100%" height="380px"></iframe>
                        <% } else if (docFormats.includes(fileExtension)) { %>
                            <!-- Display Download Link for Documents -->
                            <a href="<%= news.image.url %>" target="_blank" class="btn btn-primary">
                                View Document (<%= fileExtension.toUpperCase() %>)
                            </a>
                        <% } else { %>
                            <p>Unsupported file format!</p>
                        <% } %>
                    <div class="card-img-overlay"></i><i class="fa-solid fa-heart"></i><i
                            class="fa-solid fa-arrow-up-from-bracket"></i></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%= news.title %>
                            </b>
                        </p>
                    </div>
                </div>
            </a>
            <%} %>
    </div>